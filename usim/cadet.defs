/* cadet.defs --- Space Cadet keyboard mappings	-*- C -*-
 *
 * The syntax of the X macro is as follows:
 *	X(name, value, shift)
 */

/* Unshifted */

X(macro, 0100, CADET_IX_UNSHIFT)
X(terminal, 0040, CADET_IX_UNSHIFT)
