X(universal_quantifier,	024)
X(for_all,		024)
X(existential_quantifier, 025)
X(there_exists,		025)
X(circle_x,		026)
X(circle_cross,		026)
X(tensor,		026)
X(double_arrow,		027)
X(left_arrow,		030)
