/* lmch.defs --- Lisp Machine character mappings	-*- C -*-
 *
 * See SYS:LMIO;RDDEFS LISP for details.
 *
 * The syntax of the X macro is as follows:
 *	X(symbol, value)
 */

X(null,			0200)
X(null_character,	0200)
X(break,		0201)
X(brk,			0201)
X(suspend,		0201)
X(clear_input,		0202)
X(clear,		0202)
X(clr,			0202)
X(call,			0203)
X(terminal,		0204)
X(esc,			0204)
X(escape,		0204)
X(terminal_escape,	0204)
X(function,		0204)
X(macro,		0205)
X(back_next,		0205)
X(backnext,		0205)
X(help,			0206)
X(rubout,		0207)
X(overstrike,		0210)
X(backspace,		0210)
X(bs,			0210)
X(tab,			0211)
X(line,			0212)
X(lf,			0212)
X(linefeed,		0212)
X(line_feed,		0212)
X(delete,		0213)
X(vt,			0213)
/* The keyboard says "CLEAR SCREEN", but it should type out as "PAGE". */
X(page,			0214)
X(clear_screen,		0214)
X(form,			0214)
X(ff,			0214)
X(return,		0215)
X(newline,		0215)
X(cr,			0215)
X(quote,		0216)
X(hold_output,		0217)
