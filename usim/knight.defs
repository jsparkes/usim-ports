/* knight.defs --- Knight keyboard mappings	-*- C -*-
 *
 * The syntax of the X macro is as follows:
 *	X(name, value)
 */

X(break,	00)
X(escape,	01)
X(1,		02)
X(2,		03)
X(3,		04)
X(4,		05)
X(5,		06)
X(6,		07)
X(7,		010)
X(8,		011)
X(9,		012)
X(0,		013)
X(minus,	014)
X(at,		015)
X(asciicircum,	016)
X(bs,		017)
X(call,		020)

X(clear,	021)
X(tab,		022)
X(altmode,	023)
X(q,		024)
X(w,		025)
X(e,		026)
X(r,		027)
X(t,		030)
X(y,		031)
X(u,		032)
X(i,		033)
X(o,		034)
X(p,		035)
X(bracketleft,	036)
X(bracketright,	037)
X(backslash,	040)
X(slash,	041)
X(plus_minus,	042)
X(circle_plus,	043)

X(form,		044)
X(vt,		045)
X(rubout,	046)
X(a,		047)
X(s,		050)
X(d,		051)
X(f,		052)
X(g,		053)
X(h,		054)
X(j,		055)
X(k,		056)
X(l,		057)
X(semicolon,	060)
X(colon,	061)
X(cr,		062)
X(line,		063)
X(back_next,	064)

X(z,		065)
X(x,		066)
X(c,		067)
X(v,		070)
X(b,		071)
X(n,		072)
X(m,		073)
X(comma,	074)
X(period,	075)
X(slash1,	076)

X(sp,		077)

/* Shift */

X(exclam,	(KNIGHT_1 | KNIGHT_SHIFT))
X(quotedbl,	(KNIGHT_2 | KNIGHT_SHIFT))
X(numbersign,	(KNIGHT_3 | KNIGHT_SHIFT))
X(dollar,	(KNIGHT_4 | KNIGHT_SHIFT))
X(percent,	(KNIGHT_5 | KNIGHT_SHIFT))
X(ampersand,	(KNIGHT_6 | KNIGHT_SHIFT))
X(apostrophe,	(KNIGHT_7 | KNIGHT_SHIFT))
X(parenleft,	(KNIGHT_8 | KNIGHT_SHIFT))
X(parenright,	(KNIGHT_9 | KNIGHT_SHIFT))
X(underscore,	(KNIGHT_0 | KNIGHT_SHIFT))
X(equal,	(KNIGHT_minus | KNIGHT_SHIFT))
X(grave,	(KNIGHT_at | KNIGHT_SHIFT))
X(asciitilde,	(KNIGHT_asciicircum | KNIGHT_SHIFT))

X(Q,		(KNIGHT_q | KNIGHT_SHIFT))
X(W,		(KNIGHT_w | KNIGHT_SHIFT))
X(E,		(KNIGHT_e | KNIGHT_SHIFT))
X(R,		(KNIGHT_r | KNIGHT_SHIFT))
X(T,		(KNIGHT_t | KNIGHT_SHIFT))
X(Y,		(KNIGHT_y | KNIGHT_SHIFT))
X(U,		(KNIGHT_u | KNIGHT_SHIFT))
X(I,		(KNIGHT_i | KNIGHT_SHIFT))
X(O,		(KNIGHT_o | KNIGHT_SHIFT))
X(P,		(KNIGHT_p | KNIGHT_SHIFT))
X(braceleft,	(KNIGHT_bracketleft | KNIGHT_SHIFT))
X(braceright,	(KNIGHT_bracketright | KNIGHT_SHIFT))
X(bar,		(KNIGHT_backslash | KNIGHT_SHIFT))
X(infinity,	(KNIGHT_slash | KNIGHT_SHIFT))
X(delta,	(KNIGHT_plus_minus | KNIGHT_SHIFT))

X(A,		(KNIGHT_a | KNIGHT_SHIFT))
X(S,		(KNIGHT_s | KNIGHT_SHIFT))
X(D,		(KNIGHT_d | KNIGHT_SHIFT))
X(F,		(KNIGHT_f | KNIGHT_SHIFT))
X(G,		(KNIGHT_g | KNIGHT_SHIFT))
X(H,		(KNIGHT_h | KNIGHT_SHIFT))
X(J,		(KNIGHT_j | KNIGHT_SHIFT))
X(K,		(KNIGHT_k | KNIGHT_SHIFT))
X(L,		(KNIGHT_l | KNIGHT_SHIFT))
X(plus,		(KNIGHT_semicolon | KNIGHT_SHIFT))
X(asterisk,	(KNIGHT_colon | KNIGHT_SHIFT))

X(Z,		(KNIGHT_z | KNIGHT_SHIFT))
X(X,		(KNIGHT_x | KNIGHT_SHIFT))
X(C,		(KNIGHT_c | KNIGHT_SHIFT))
X(V,		(KNIGHT_v | KNIGHT_SHIFT))
X(B,		(KNIGHT_b | KNIGHT_SHIFT))
X(N,		(KNIGHT_n | KNIGHT_SHIFT))
X(M,		(KNIGHT_m | KNIGHT_SHIFT))
X(less,		(KNIGHT_comma | KNIGHT_SHIFT))
X(greater,	(KNIGHT_period | KNIGHT_SHIFT))
X(question,	(KNIGHT_slash1 | KNIGHT_SHIFT))

/* Top */

X(network,		(KNIGHT_break | KNIGHT_TOP))
X(system,		(KNIGHT_escape | KNIGHT_TOP))
X(abort,		(KNIGHT_call | KNIGHT_TOP))
X(and_sign,		(KNIGHT_q | KNIGHT_TOP))
X(or_sign,		(KNIGHT_w | KNIGHT_TOP))
X(up_horseshoe,		(KNIGHT_e | KNIGHT_TOP))
X(down_horseshoe,	(KNIGHT_r | KNIGHT_TOP))
X(left_horseshoe,	(KNIGHT_t | KNIGHT_TOP))
X(right_horseshoe,	(KNIGHT_y | KNIGHT_TOP))
X(not_sign,		(KNIGHT_u | KNIGHT_TOP))
X(circle_x,		(KNIGHT_i | KNIGHT_TOP))
X(down_arrow,		(KNIGHT_o | KNIGHT_TOP))
X(up_arrow,		(KNIGHT_p | KNIGHT_TOP))
X(less_or_equal,	(KNIGHT_a | KNIGHT_TOP))
X(greater_or_equal,	(KNIGHT_s | KNIGHT_TOP))
X(equivalence,		(KNIGHT_d | KNIGHT_TOP))
X(partial_delta,	(KNIGHT_f | KNIGHT_TOP))
X(not_equal,		(KNIGHT_g | KNIGHT_TOP))
X(help,			(KNIGHT_h | KNIGHT_TOP))
X(left_arrow,		(KNIGHT_j | KNIGHT_TOP))
X(right_arrow,		(KNIGHT_k | KNIGHT_TOP))
X(double_arrow,		(KNIGHT_l | KNIGHT_TOP))
X(end,			(KNIGHT_cr | KNIGHT_TOP))
X(alpha,		(KNIGHT_z | KNIGHT_TOP))
X(beta,			(KNIGHT_x | KNIGHT_TOP))
X(epsilon,		(KNIGHT_c | KNIGHT_TOP))
X(lambda,		(KNIGHT_v | KNIGHT_TOP))
X(pi,			(KNIGHT_b | KNIGHT_TOP))
X(universal_quantifier,	(KNIGHT_n | KNIGHT_TOP))
X(existential_quantifier, (KNIGHT_m | KNIGHT_TOP))
