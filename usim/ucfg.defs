X(chaos, bridgeip, "10.0.0.1")
X(chaos, bridgechaos, "3040")
X(chaos, bridgeport, "42042")
X(chaos, bridgeport_local, "42042")
X(chaos, udp_local_hybrid, "false")

X(memory, size, "2048")

