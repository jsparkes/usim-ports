/* -*- C -*-
 *
 * The syntax of the X macro is as follows:
 * 	X(section, name, default)
 */

X(usim, state_filename, "")
X(usim, screenshot_filename, "")
X(usim, sys_directory, NULL)
X(usim, fs_root_directory, "..")
X(usim, monitor, "other")
X(usim, geometry, "-1 -1 -1")
X(usim, always_on_top, "false")
X(usim, kbd, "cadet")
X(usim, grab_keyboard, "true")
X(usim, headless, "false")
X(usim, scale, "1")
X(usim, scale_filter, "linear")
X(usim, allow_resize, "false")
X(usim, beep_amplitude, "0.8")
X(usim, use_ascii_beep, "false")
X(usim, special_key, "")

X(ucode, prommcr_filename, "../sys/ubin/promh.mcr")
X(ucode, promsym_filename, "../sys/ubin/promh.sym")
X(ucode, mcrsym_filename, "../sys/ubin/ucadr.sym")

X(chaos, backend, "local")
X(chaos, hosts, "hosts.text")
